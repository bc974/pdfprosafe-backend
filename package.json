{
  "name": "pdfprosafe-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Stateless Node.js conversion service for pdfprosafe.com — PDF→Word and PDF→Excel. Files are processed in memory and never written to disk.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "docx": "^9.6.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "mammoth": "^1.8.0",
    "multer": "^2.0.1",
    "pdf-to-img": "^6.1.0",
    "pdfjs-dist": "^5.7.284",
    "pdfkit": "^0.19.0",
    "pptxgenjs": "^4.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
